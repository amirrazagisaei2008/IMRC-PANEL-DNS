{
  "name": "imrc-panel-dns",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./Public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imrc-db",
      "database_id": "PUT_DATABASE_ID_HERE"
    }
  ]
}
